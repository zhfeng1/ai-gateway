# 默认继续使用 SQLite。
DATABASE_TYPE=sqlite

# AI Gateway 使用 PostgreSQL 时取消注释，并把账号密码替换为实际值。
# DATABASE_TYPE=postgres
# DATABASE_URL=jdbc:postgresql://user:password@192.168.1.26:8097/ai-gateway

# new-api 独立日志库。检测到 x-oneapi-request-id 后会异步查询 logs 表。
# NEW_API_LOG_DATABASE_URL=jdbc:postgresql://user:password@192.168.1.26:8097/new-api-log
NEW_API_LOG_TABLES=logs
NEW_API_LOG_QUERY_TIMEOUT_SECONDS=3
