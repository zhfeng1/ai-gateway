# 默认继续使用 SQLite。
DATABASE_TYPE=sqlite

# AI Gateway 使用 PostgreSQL 时取消注释，并把账号密码替换为实际值。
# DATABASE_TYPE=postgres
# DATABASE_URL=jdbc:postgresql://user:password@192.168.1.26:8097/ai-gateway

# new-api 独立日志库。检测到 x-oneapi-request-id 后会异步查询 logs 表。
# NEW_API_LOG_DATABASE_URL=jdbc:postgresql://user:password@192.168.1.26:8097/new-api-log
NEW_API_LOG_TABLES=logs
NEW_API_LOG_QUERY_TIMEOUT_SECONDS=3

# 输出超过阈值的分阶段性能日志，可按 x-oneapi-request-id 从 docker logs 中检索。
PERFORMANCE_LOG_ENABLED=1
PERFORMANCE_LOG_THRESHOLD_MS=100

# 复用上游 HTTP 连接，减少高并发下重复建连开销。
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE_CONNECTIONS=200
HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# OpenAI Responses SSE 出现 response.failed 时发送钉钉机器人通知。
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-token
DINGTALK_WEBHOOK_TIMEOUT_SECONDS=10
