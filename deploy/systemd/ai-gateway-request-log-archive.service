[Unit]
Description=Archive AI Gateway request logs from seven days ago
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/TRS/APP/ai-gateway
ExecStartPre=/usr/bin/docker inspect ai-gateway
ExecStart=/usr/bin/docker exec ai-gateway python /app/scripts/archive_request_logs.py --archive-dir /data/request-log-archives --day-offset 7
TimeoutStartSec=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

